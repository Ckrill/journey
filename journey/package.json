{
  "name": "journey",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://journey.vercel.app",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "echo '▶ Oxfmt' && oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "yarn lint:css && yarn lint:js",
    "lint:css": "echo '▶ Stylelint' && stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:js": "echo '▶ ESLint' && eslint src/",
    "lint:js:fix": "eslint src/ --fix",
    "typecheck": "echo '▶ TypeScript' && tsc --noEmit",
    "validate": "yarn format && yarn lint && yarn typecheck",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-core": "^1.169.1",
    "contentful-management": "^12.3.2",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint-react/eslint-plugin": "^5.7.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.100.11",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.167.32",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "knip": "^6.11.0",
    "oxfmt": "^0.51.0",
    "postcss": "^8.5.14",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.10.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "dependenciesMeta": {
    "oxfmt@0.51.0": {
      "unplugged": true
    }
  },
  "resolutions": {
    "react-icons": "5.4.0"
  },
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
