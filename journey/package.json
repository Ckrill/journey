{
  "name": "journey",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://journey.vercel.app",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "echo '🔍 Oxfmt' && oxfmt --list-different && printf '\\033[1A\\r✅ Oxfmt\\n'",
    "format:fix": "oxfmt",
    "lint": "yarn lint:css && yarn lint:js",
    "lint:css": "echo '🔍 Stylelint' && stylelint \"src/**/*.{css,scss}\" && printf '\\033[1A\\r✅ Stylelint\\n'",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:js": "echo '🔍 ESLint' && eslint src/ && printf '\\033[1A\\r✅ ESLint\\n'",
    "lint:js:fix": "eslint src/ --fix",
    "typecheck": "echo '🔍 TypeScript' && tsc --noEmit && printf '\\033[1A\\r✅ TypeScript\\n'",
    "validate": "yarn format && yarn lint && yarn typecheck && echo '🎉 All checks passed!'",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-core": "^1.171.13",
    "contentful-management": "^12.5.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint-react/eslint-plugin": "^5.8.16",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@tsconfig/vite-react": "^8.0.6",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.53.0",
    "postcss": "^8.5.15",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "dependenciesMeta": {
    "oxfmt": {
      "unplugged": true
    }
  },
  "resolutions": {
    "react-icons": "5.4.0"
  },
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
